{
  "manifest_version": 3,
  "name": "Commonplace · YouTube history",
  "description": "Import the last 12 months of your YouTube history into your local Commonplace inbox.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Import YouTube history" }
}
