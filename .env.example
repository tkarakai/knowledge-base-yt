# bun run dev:kb generates an ephemeral companion token and shares it only with
# the server processes. Set a stable 32+ character token only for manual starts.
# KB_COMPANION_TOKEN=
KB_VAULT_PATH=./vault
KB_COMPANION_PORT=4317
KB_WEB_PORT=3001
# Configure inference/embedding endpoints and models in the app Settings screen.
# API keys are stored locally by the companion; never use NEXT_PUBLIC_ for keys.
