{
  "name": "knowledge-base-yt",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "./scripts/ensure-local-deps.sh --quiet && ./scripts/ensure-app-env.sh --quiet && ./scripts/copy-shared-assets.sh",
    "dev": "./scripts/dev-start.sh",
    "dev:ci": "./scripts/dev-start.sh --ci",
    "dev:web": "./scripts/dev-start.sh --app=web",
    "dev:admin": "./scripts/dev-start.sh --app=admin",
    "dev:landing": "./scripts/dev-start.sh --app=landing",
    "dev:storybook": "./scripts/dev-start.sh --app=storybook",
    "dev:landing-static": "turbo dev --filter=@repo/landing-static",
    "ensure-local": "./scripts/ensure-local-deps.sh",
    "dev:stop": "./scripts/dev-stop.sh",
    "dev:stop:convex": "./scripts/dev-stop-convex.sh",
    "dev:nuke-db": "./scripts/dev-nuke-db.sh",
    "dev:nuke-all": "./scripts/dev-nuke-all.sh",
    "dev:status": "./scripts/dev-status.sh",
    "copy-assets": "./scripts/copy-shared-assets.sh",
    "prebuild": "./scripts/ensure-app-env.sh --quiet",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:convex": "turbo test:convex",
    "pretest:e2e": "./scripts/ensure-app-env.sh --quiet",
    "test:e2e": "turbo test:e2e",
    "test:all": "turbo test test:unit test:convex test:e2e",
    "clean": "rm -rf apps/*/.next apps/*/.turbo packages/*/.turbo .turbo",
    "ci": "./scripts/ci-local.sh",
    "ci:quick": "./scripts/ci-local.sh --skip-e2e",
    "ci:reset-coverage": "./scripts/ci-local.sh --reset-coverage",
    "ci:act": "./scripts/ci-local-act.sh",
    "ci:act:quick": "./scripts/ci-local-act.sh -q",
    "ci:act:offline": "./scripts/ci-local-act.sh -o",
    "infra:setup:staging": "./scripts/infra-setup-staging.sh",
    "ensure-env": "./scripts/ensure-app-env.sh",
    "dev:kb": "bun scripts/dev-kb.ts",
    "test:kb": "bun test packages/kb packages/ingestion packages/search packages/agent apps/companion apps/extension/src",
    "typecheck:kb": "bun run --filter @repo/kb --filter @repo/ingestion --filter @repo/search --filter @repo/kb-agent --filter @repo/companion --filter @repo/history-extension typecheck",
    "build:extension": "bun run --filter @repo/history-extension build",
    "test:history:e2e": "bun run build:extension && bun scripts/history-e2e.ts",
    "kb:rebuild": "bun apps/companion/src/rebuild.ts",
    "test:kb:e2e": "bun scripts/kb-e2e.ts",
    "format:kb": "prettier --write packages/shared packages/agent packages/kb packages/ingestion packages/search apps/companion apps/web/src/components/kb apps/web/src/lib/kb apps/web/src/app/kb scripts/dev-kb.ts scripts/kb-e2e.ts scripts/build-kb.ts",
    "lint:kb": "eslint packages/shared/src packages/agent/src packages/kb/src packages/ingestion/src packages/search/src apps/companion/src apps/extension/src apps/extension/build.ts apps/web/src/components/kb apps/web/src/lib/kb apps/web/src/app/kb scripts/dev-kb.ts scripts/kb-e2e.ts scripts/history-e2e.ts scripts/build-kb.ts scripts/kb-perf.ts",
    "build:kb": "bun scripts/build-kb.ts",
    "test:kb:perf": "bun scripts/kb-perf.ts",
    "test:kb:perf:browser": "KB_PERF_BROWSER=1 bun scripts/kb-e2e.ts"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "convex": "1.31.7",
    "next": "16.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "3.6.2",
    "turbo": "^2.5.0",
    "typescript": "5.9.3"
  }
}
